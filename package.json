{
  "name": "dungeon-directory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
    "test:ci": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
    "coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "a11y:report": "axe http://localhost:5173 --save reports/axe-report.json --tags wcag2a,wcag2aa --exit 0",
    "generateSdk": "openapi-typescript openapi.json --output frontend/src/sdk/openapi.ts",
    "postinstall": "husky install"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.7.1",
    "@commitlint/cli": "^18.5.0",
    "@commitlint/config-conventional": "^18.5.0",
    "@playwright/test": "^1.44.0",
    "@storybook/addon-actions": "8.1.0",
    "@storybook/addon-essentials": "8.1.0",
    "@storybook/addon-interactions": "8.1.0",
    "@storybook/react": "8.1.0",
    "@storybook/react-vite": "8.1.0",
    "@storybook/testing-library": "^0.2.2",
    "autoprefixer": "^10.4.16",
    "commander": "^9.5.0",
    "commitizen": "^4.3.0",
    "coveralls": "^3.1.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "node-fetch": "^2.7.0",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.4.24",
    "storybook-dark-mode": "^1.0.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "vite": "^5.0.5"
  }
}
